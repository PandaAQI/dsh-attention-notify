{
  "name": "dsh-attention-notify",
  "version": "0.1.0",
  "description": "Desktop notifications when DeepSeek Harness needs you: tool approvals and user questions, delivered through notify-send",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test test/",
    "check": "node --check lib/index.js && node --check lib/notify.js"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis",
    "notification",
    "notify-send",
    "approval"
  ],
  "license": "MIT",
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
